# Environment variables for the MoveNow lab.
# Copy this file to .env (ignored by Git) and fill in the values:
#   cp .env.example .env
#   set -a; source .env; set +a                  shell: gcloud, terraform, producer
#   node --env-file=../../.env server.mjs        dashboard, from movenow/tableau
#
# Nothing secret here. Locally, authentication goes through ADC
# (gcloud auth application-default login); in CI, through workload identity federation.
# Never put a service account JSON key in this file.

# --- GCP project: values given by the instructor ------------------------------
GOOGLE_CLOUD_PROJECT=groupe3inssettp
REGION=europe-west9
# Group prefix, used in every resource name
PREFIX=g3-movenow
# Terraform state bucket created by infra/bootstrap (terraform output state_bucket)
TF_STATE_BUCKET=groupe3inssettp-g3-movenow-tfstate

# --- Terraform: TF_VAR_<name> sets the variable <name> ------------------------
TF_VAR_project_id=groupe3inssettp
TF_VAR_region=europe-west9
TF_VAR_prefix=g3-movenow
# Recipient of the Monitoring alerts
TF_VAR_alert_email=first.last@example.com

# --- Producer: node producteur.mjs --topic "$TOPIC" ... -----------------------
# It reads GOOGLE_CLOUD_PROJECT above; the topic is passed as an argument.
TOPIC=g3-movenow-positions

# --- Dashboard, bigquery mode -------------------------------------------------
# Reading the real table runs billed queries: uncomment SOURCE only for the demo.
# SOURCE=bigquery
BQ_TABLE=groupe3inssettp.movenow.positions
BQ_LOCATION=europe-west9
SUBSCRIPTION=g3-movenow-positions-bq
DEAD_LETTER_SUBSCRIPTION=g3-movenow-positions-dead-letter-inspection
REFRESH_SECONDS=20

# --- Dashboard, emulator mode (docker compose already sets these) -------------
# PUBSUB_EMULATOR_HOST=localhost:8085
# PUBSUB_PROJECT_ID=movenow-local
# LOTS_DIR=./lots
# MAX_DELIVERY_ATTEMPTS=5
